# Backend Environment Variables
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/generated_db
JWT_SECRET=your_super_secret_jwt_key_replace_me_in_production

# Frontend Environment Variables (for local development with Vite)
# This variable is used by Vite to know where your backend API is.
# When running with docker-compose, the frontend container will use the backend service name.
# When building the frontend Docker image, this value is passed as a build argument.
VITE_APP_BACKEND_URL=http://localhost:5000
